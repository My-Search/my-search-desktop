{
  "id": "com.mysearch.clipboard",
  "name": "剪贴板历史",
  "version": "1.4.3",
  "apiVersion": 1,
  "minAppVersion": "7.9.15",
  "author": "zhuangjie",
  "description": "自动记录你复制过的文本与图片，按快捷键呼出即可搜索、复制、删除、收藏。收藏的条目永久保留、不会被上限淘汰或清空，还可就地编辑内容。监听在后台原生完成，不干扰系统剪贴板。",
  "changelog": "修复列表图片缩略图在重渲染（复制/切标签/刷新）后被清回占位文字的问题：重渲染后会回填已缓存的预览图。",
  "repository": "https://github.com/My-Search/my-search-desktop/tree/master/plugins/clipboard",
  "icon": "icon.svg",
  "permissions": [
    "ui.inlay",
    "ui.notify",
    "store",
    "clipboard.read",
    "clipboard.write"
  ],
  "contributes": {
    "searchItem": {
      "title": "剪贴板历史",
      "desc": "查看 / 搜索 / 复制最近复制过的文本与图片",
      "keyword": "剪贴板",
      "icon": "icon.svg",
      "subSearch": false
    },
    "detailView": {
      "entry": "ui/detail.html",
      "script": "ui/index.js",
      "mode": "inlay",
      "closeBehavior": "minimize",
      "theme": "inherit"
    },
    "shortcut": {
      "action": "clipboard",
      "title": "剪贴板历史",
      "defaultShortcut": "ctrl+alt+v"
    }
  }
}
