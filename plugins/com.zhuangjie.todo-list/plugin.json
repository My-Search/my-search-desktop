{
  "id": "com.zhuangjie.todo-list",
  "name": "待办清单",
  "version": "1.0.0",
  "apiVersion": 1,
  "minAppVersion": "7.9.15",
  "author": "zhuangjie",
  "description": "本地待办清单：增删改查、优先级、标签、截止日期、筛选统计与 JSON 导出导入",
  "homepage": "https://github.com/zhuangjie/todo-list",
  "icon": "icon.svg",
  "permissions": [
    "ui.inlay",
    "store"
  ],
  "optionalPermissions": [
    "ui.notify"
  ],
  "contributes": {
    "searchItem": {
      "title": "待办清单 Todo",
      "desc": "管理本地待办（todo / todos）：紧急等级、标签、截止日期、排序筛选，支持「待办 : 买牛奶」快速新增",
      "keyword": "待办",
      "icon": "icon.svg",
      "subSearch": true
    },
    "detailView": {
      "entry": "ui/detail.html",
      "script": "ui/index.js",
      "mode": "inlay",
      "closeBehavior": "minimize"
    }
  }
}
