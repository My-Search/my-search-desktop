{
  "id": "com.zhuangjie.todo-list",
  "name": "待办清单",
  "version": "1.3.0",
  "apiVersion": 1,
  "minAppVersion": "7.9.15",
  "autoUpdate": true,
  "author": "zhuangjie",
  "description": "本地待办清单：增删改查、详情备注、优先级、标签、截止日期、筛选统计与 JSON 导出导入",
  "homepage": "https://github.com/zhuangjie/todo-list",
  "repository": "https://github.com/My-Search/my-search-desktop/tree/master/plugins/com.zhuangjie.todo-list",
  "icon": "icon.svg",
  "changelog": "新增：行内编辑时可直接改紧急等级——编辑行最前面新增「未设置 / 紧急 / 普通 / 低」下拉，选中即保存到该条待办，不必再靠标题里手写「!紧急」。文本里写了等级仍以文本为准。",
  "permissions": [
    "ui.inlay",
    "store"
  ],
  "optionalPermissions": [
    "ui.notify"
  ],
  "contributes": {
    "searchItem": {
      "title": "待办清单 Todo",
      "desc": "管理本地待办（todo / todos）：紧急等级、标签、截止日期、排序筛选，支持「待办 : 买牛奶」快速新增",
      "keyword": "待办",
      "icon": "icon.svg",
      "subSearch": true
    },
    "detailView": {
      "entry": "ui/detail.html",
      "script": "ui/index.js",
      "mode": "inlay",
      "closeBehavior": "minimize"
    },
    "shortcut": {
      "action": "open-todo",
      "title": "待办清单（呼出并聚焦输入）",
      "defaultShortcut": "ctrl+alt+t"
    }
  }
}
