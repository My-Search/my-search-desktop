{
  "id": "com.mysearch.pi-agent",
  "name": "Pi Agent",
  "version": "2.7.0",
  "apiVersion": 1,
  "minAppVersion": "7.9.15",
  "author": "my-search",
  "description": "Pi 编码代理 - 支持多项目、多模型、模型配置面板、插件管理、流式对话与工具调用",
  "homepage": "https://github.com/My-Search/my-search-desktop",
  "icon": "icon.svg",
  "permissions": [
    "ui.inlay",
    "ui.notify",
    "store",
    "backend.spawn",
    "file.read"
  ],
  "optionalPermissions": [],
  "contributes": {
    "searchItem": [
      {
        "title": "Pi Agent",
        "desc": "编码代理 - 选择项目开始对话",
        "keyword": "AI",
        "visible": true,
        "subSearch": true
      }
    ],
    "detailView": {
      "entry": "ui/detail.html",
      "script": "ui/index.js",
      "mode": "inlay",
      "theme": "dark"
    }
  },
  "backend": {
    "entry": "backend/run.cmd",
    "protocol": "jsonrpc-stdio",
    "autostart": "on-demand",
    "closeBehavior": "minimize",
    "startupTimeoutMs": 60000,
    "callTimeoutMs": 300000,
    "idleExitSec": 0,
    "maxRestarts": 3
  }
}
