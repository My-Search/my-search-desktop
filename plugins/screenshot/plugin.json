{
  "id": "com.zhuangjie.screenshot",
  "name": "截图",
  "version": "1.4.1",
  "apiVersion": 1,
  "minAppVersion": "7.9.15",
  "autoUpdate": true,
  "author": "zhuangjie",
  "description": "全局快捷键截图：框选区域、标注后复制到剪贴板，并可把剪贴板图片贴在屏幕上，前台查看最近 7 天的截图",
  "changelog": "贴图默认快捷键调整为 Ctrl+Alt+P（释放 Ctrl+Alt+V 给剪贴板历史）；支持默认自动更新。",
  "homepage": "https://github.com/zhuangjie/screenshot",
  "repository": "https://github.com/My-Search/my-search-desktop/tree/master/plugins/screenshot",
  "icon": "icon.svg",
  "permissions": [
    "ui.inlay",
    "ui.notify",
    "store",
    "clipboard.read",
    "clipboard.write",
    "screenshot.capture",
    "screenshot.overlay",
    "screenshot.write",
    "screenshot.read"
  ],
  "optionalPermissions": [
    "backend.spawn"
  ],
  "contributes": {
    "searchItem": {
      "title": "截图",
      "desc": "按快捷键框选截图、标注后复制；把剪贴板图片贴在屏幕上；查看最近 7 天的截图",
      "keyword": "截图",
      "icon": "icon.svg",
      "subSearch": false
    },
    "detailView": {
      "entry": "ui/detail.html",
      "script": "ui/index.js",
      "mode": "inlay",
      "closeBehavior": "exit",
      "theme": "inherit"
    },
    "shortcut": [
      {
        "action": "screenshot",
        "title": "截图（框选 + 标注）",
        "defaultShortcut": "ctrl+alt+x"
      },
      {
        "action": "pin",
        "title": "贴图（钉住剪贴板图片）",
        "defaultShortcut": "ctrl+alt+p"
      }
    ]
  },
  "backend": {
    "entry": "backend/run.cmd",
    "command": ["node", "backend/index.mjs"],
    "protocol": "jsonrpc-stdio",
    "autostart": "on-demand",
    "closeBehavior": "exit",
    "startupTimeoutMs": 15000,
    "callTimeoutMs": 20000,
    "idleExitSec": 300,
    "maxRestarts": 0
  }
}
