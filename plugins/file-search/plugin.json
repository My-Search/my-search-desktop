{
  "id": "com.mysearch.file-search",
  "name": "文件搜索",
  "version": "1.3.0",
  "apiVersion": 1,
  "minAppVersion": "7.9.22",
  "autoUpdate": true,
  "author": "my-search",
  "description": "在选择/粘贴/拖入的文件夹里按名称搜索文件：一直扫描、边扫边显示，随时可停止；回车或点击用系统默认程序打开",
  "repository": "https://github.com/My-Search/my-search-desktop/tree/master/plugins/file-search",
  "icon": "icon.svg",
  "changelog": "新增：界面右上角「选择文件夹」——弹系统对话框直接挑选要搜索的电脑文件夹（可多选），不再只能靠粘贴/拖入搜索框；文件夹 chips 尾部新增 ×，可一键把某个文件夹移出搜索范围。旧版应用里按钮自动隐藏，行为不变。",
  "permissions": [
    "ui.inlay",
    "file.read"
  ],
  "contributes": {
    "searchItem": {
      "title": "文件搜索",
      "desc": "粘贴/拖入文件夹后，在其中按名称搜索文件",
      "keyword": "文件搜索",
      "icon": "icon.svg",
      "subSearch": true
    },
    "handlers": {
      "folders": true
    },
    "detailView": {
      "entry": "ui/detail.html",
      "script": "ui/index.js",
      "mode": "inlay",
      "closeBehavior": "exit"
    }
  }
}
