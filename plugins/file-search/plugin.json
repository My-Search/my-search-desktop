{
  "id": "com.mysearch.file-search",
  "name": "文件搜索",
  "version": "1.4.0",
  "apiVersion": 1,
  "minAppVersion": "7.9.22",
  "autoUpdate": true,
  "author": "my-search",
  "description": "在选择/粘贴/拖入的文件夹里按名称搜索文件：一直扫描、边扫边显示，随时可停止；回车或点击用系统默认程序打开",
  "repository": "https://github.com/My-Search/my-search-desktop/tree/master/plugins/file-search",
  "icon": "icon.svg",
  "changelog": "新增：插件界面顶部关键词输入框——选好文件夹后直接在插件里输入关键词即搜（300ms 防抖即搜、回车立即搜、Esc 清空），不必再去搜索框输「文件搜索 : xx」；选好文件夹/待命时焦点自动落到输入框，搜索框子关键词入口仍兼容（与输入框互为镜像）。",
  "permissions": [
    "ui.inlay",
    "file.read",
    "search.write"
  ],
  "contributes": {
    "searchItem": {
      "title": "文件搜索",
      "desc": "粘贴/拖入文件夹后，在其中按名称搜索文件",
      "keyword": "文件搜索",
      "icon": "icon.svg",
      "subSearch": true
    },
    "handlers": {
      "folders": true
    },
    "shortcut": {
      "action": "open-file-search",
      "title": "文件搜索（呼出并聚焦输入）",
      "defaultShortcut": "alt+s"
    },
    "detailView": {
      "entry": "ui/detail.html",
      "script": "ui/index.js",
      "mode": "inlay",
      "closeBehavior": "exit"
    }
  }
}
