{
  "id": "com.mysearch.file-search",
  "name": "文件搜索",
  "version": "1.1.0",
  "apiVersion": 1,
  "minAppVersion": "7.9.15",
  "author": "my-search",
  "description": "在粘贴/拖入的文件夹里按名称搜索文件，回车或点击用系统默认程序打开",
  "icon": "icon.svg",
  "permissions": [
    "ui.inlay",
    "file.read"
  ],
  "contributes": {
    "searchItem": {
      "title": "文件搜索",
      "desc": "粘贴/拖入文件夹后，在其中按名称搜索文件",
      "keyword": "文件搜索",
      "icon": "icon.svg",
      "subSearch": true
    },
    "handlers": {
      "folders": true
    },
    "detailView": {
      "entry": "ui/detail.html",
      "script": "ui/index.js",
      "mode": "inlay",
      "closeBehavior": "exit"
    }
  }
}
