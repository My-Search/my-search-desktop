{
  "name": "my-search-desktop",
  "version": "7.9.15",
  "description": "我的搜索桌面版 - 订阅式搜索工具（打造订阅式搜索，让我的搜索，只搜精品！）",
  "author": "zhuangjie",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
