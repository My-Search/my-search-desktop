# 依赖
node_modules/
dist/

# Rust 构建产物
src-tauri/target/
src-tauri/target-live/
src-tauri/gen/

# 图标生成的中间产物（可用 `npm run icons` 重新生成）
test/_icons/

# 测试临时工作目录（打包产物 / 调试脚本 / 浏览器 profile）
test/_tmp/

# UI 测试的运行期产物（浏览器 profile 目录、截图；测试结束会自行清理   ，
# 异常中断时会残留，不应提交）
test/_chrome-profile-*/
test/.e2e-drag-profile/
test/.e2e-release-profile/
test/.e2e-autostart-profile/
test/.e2e-rclick-profile/
test/.e2e-cold-profile/
test/.e2e-plugin-shortcut-profile/
test/_shot-*.png
test/_rel-shot-*.png
test/_cold-shot*.png
test/.cache-restart-store.json
test/_fix-*.mjs

# 系统文件
.DS_Store
*.log
*.bak

# IDE
.idea/
.vscode/
*.iml
.lithe/

# AI 助手会话产物（计划草稿等，非项目内容）
.zcode/

# 插件市场索引产物（由 CI 生成并提交到市场仓库，不应留在本仓库）
/index.dist.json
/index.error.json
/error-item.txt

# 根目录调试残留（评审期间产生，不入库；文件本身保留在工作区）
/nul
/_capture.ps1
/style.diff
/pi-agent-seen.json
/下载.jpg

# test/ 下的评审/诊断临时产物（跑分、抓包、补丁试验与浏览器 profile 快照）
# 注意：正式用例 test/*.test.mjs 与可复用脚本（_check-doc-sync / _verify-market-publish）不在此列
/test/_rev-*
/test/_out-*
/test/_o-*.txt
/test/_patch*.mjs
/test/_chrome_probe*/
/test/_diag-tags*
